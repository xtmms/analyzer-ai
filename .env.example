# Copia questo file in .env nella root del progetto e valorizzalo.
# Il backend legge .env dalla directory da cui viene avviato uvicorn
# (root del repo, vedi backend/app/settings.py e AGENTS.md).

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Database ---
# SQLite per sviluppo locale; in produzione puntare a Postgres,
# es. postgresql+psycopg://user:password@host:5432/analyzer
DATABASE_URL=sqlite:///./analyzer.db

# --- Chiavi piattaforma provider AI ---
# Almeno una è necessaria: un provider senza chiave non compare nel
# selettore del frontend (vedi core/ai_providers/registry.py).
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Piani/quota (nessun collegamento a un pagamento reale in questa fase) ---
FREE_PLAN_MONTHLY_LIMIT=10
PRO_PLAN_MONTHLY_LIMIT=500

# --- Hardening ---
MAX_UPLOAD_CHARS=5000000
CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_ANALYZE=20/minute
